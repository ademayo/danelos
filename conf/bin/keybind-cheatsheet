#!/bin/bash
# Keybind Cheatsheet — Reads the Binds Hyprland Is Actually Using Right Now
# Via `hyprctl binds -j` and shows them in fuzzel. Always Accurate, Even After
# Config Edits, Because Hyprland Reports Its Live State.

set -euo pipefail

command -v jq >/dev/null || { echo "jq required" >&2; exit 1; }
command -v hyprctl >/dev/null || { echo "hyprctl not found — is Hyprland running?" >&2; exit 1; }

tab=$'\t'

output=$(hyprctl binds -j | jq -r '.[] | [.modmask, .key, (if .description == "" then (.dispatcher + " " + .arg) else .description end)] | @tsv' \
    | sort -t"$tab" -k3 \
    | while IFS="$tab" read -r mask key desc; do
        mod=""
        (( mask & 64  )) && mod+="SUPER+"
        (( mask & 8   )) && mod+="ALT+"
        (( mask & 4   )) && mod+="CTRL+"
        (( mask & 1   )) && mod+="SHIFT+"
        (( mask & 16  )) && mod+="MOD2+"
        (( mask & 32  )) && mod+="MOD3+"
        (( mask & 128 )) && mod+="MOD5+"
        mod="${mod%+}"
        printf "%-24s %-14s %s\n" "${mod:-none}" "$key" "$desc"
      done)

printf '%s' "$output" | fuzzel -d \
    -p "Keybinds  ($(( $(printf '%s' "$output" | wc -l) )) binds)" \
    --width 52