# -*- rofi -*-
# rofi — Arc Dark
configuration {
    modi: "run,drun,window,ssh"
    show-icons: true
    icon-theme: "Papirus-Dark"
    font: "Adwaita Sans 11"
    terminal: "alacritty"
    display-drun: "Apps"
    display-run: "Run"
    display-window: "Windows"
    display-ssh: "SSH"
    drun-display-format: "{name}"
}

* {
    bg: #2b2e34;
    bg-alt: #383e4a;
    bg-sel: #5294e2;
    fg: #d3dae3;
    fg-alt: #8b8f98;
    accent: #5294e2;
    urgent: #f8606a;

    background-color: transparent;
    text-color: @fg;
    font: "Adwaita Sans 11";
}

window {
    location: center;
    width: 44em;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    padding: 14px;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 10px 12px;
    margin: 0 0 10px 0;
    background-color: @bg-alt;
    border-radius: 8px;
}

prompt {
    text-color: @accent;
    font-weight: bold;
}

entry {
    placeholder: "Search…";
    placeholder-color: @fg-alt;
}

listview {
    lines: 8;
    spacing: 3px;
    scrollbar: true;
    scrollbar-width: 6px;
    scrollbar-handle: @accent;
    fixed-height: false;
}

element {
    padding: 7px 10px;
    border-radius: 8px;
    background-color: transparent;
}

element selected {
    background-color: @bg-sel;
    text-color: #ffffff;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 22px;
    padding: 0 8px 0 0;
}