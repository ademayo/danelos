  echo -e "${Y}  v${VERSION} — Stock ISO · Wi-Fi Ready · The Whole Rig Will Be Wiped, No Take-Backs${N}"
}
log()  { echo -e "${G}::${N} $*" | tee -a "$LOG"; }
step() { echo -e "\n${C}==> ${B}$*${N}" | tee -a "$LOG"; }
warn() { echo -e "${Y} !! $*${N}" | tee -a "$LOG"; }
die()  { echo -e "${D}FATAL: $*${N}" | tee -a "$LOG" >&2; exit 1; }

# ----------------------------------------------------------------------------
# Preflight
# ----------------------------------------------------------------------------
[ "$(id -u)" = 0 ] || die "Run As Root — Boot The Stock ISO And Log In As The Live User."
grep -qs 'Artix' /etc/os-release || die "This Installer Must Run On Artix Linux."

# Stock Artix Live Detection: The Initramfs Mounts the Live Root Under
# /run/artix (iso-initcpio 'artix' Hook) And Boot Params Carry
# label=/overlay=livefs.
live_ok() {
  [ -d /run/artix ] && return 0
  grep -qs 'overlay=livefs\|label=ARTIX' /proc/cmdline && return 0
  mountpoint -q /run/artix/bootmnt 2>/dev/null
}

if ! live_ok; then
  die "Not Running From The Artix Live Environment. Boot The Stock Artix ISO."
fi

# ----------------------------------------------------------------------------
# Dependencies (Only What a Stock Artix ISO Lacks)
# ----------------------------------------------------------------------------
ensure_deps() {
  step "Checking Dependencies"
  # basestrap/artix-chroot/fstabgen Ship On Every Artix Live ISO (artools-base,
  # Dependency Of artix-live-base). whiptail/git Are On the Stock base-dinit
  # ISO; Anything Else Gets Pulled From the Repos.
  local missing=()
  for c in whiptail sgdisk curl vim git; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    log "Installing Missing ISO Tools: ${missing[*]}"
    pacman -Sy --noconfirm --needed libnewt gptfdisk curl vim git >>"$LOG" 2>&1
  fi
  for c in whiptail sgdisk basestrap artix-chroot fstabgen git; do
    command -v "$c" >/dev/null 2>&1 || die "$c Unavailable — Install Libnewt, Gptfdisk, Artools-Base, Git First."
  done
}

# ----------------------------------------------------------------------------
# Network (Wi-Fi Selection Or Skip If Already Online)
# ----------------------------------------------------------------------------
setup_network() {
  step "Checking Network Connectivity"

  # Online Already (Ethernet Or Prior Connection)? Offer Skip.
  if ping -c1 -W3 geo-mirror.chaotic.cx >/dev/null 2>&1; then
    if whiptail --yesno --defaultyes "Network Is Already Online. Skip Wi-Fi Setup?" 10 55 \
       --title "Artix — Network" 3>&1 1>&2 2>&3; then
      return 0
    fi
  fi

  command -v nmcli >/dev/null 2>&1 || die "nmcli Unavailable — The Live ISO Should Ship NetworkManager."

  while :; do
    step "Scanning For Wi-Fi Networks"
    # Trigger a Fresh Scan; Ignore Failure (Driver May Refuse While Up).
    nmcli device wifi rescan >/dev/null 2>&1 || true
    sleep 2

    local -a nets=() line ssid sig sec
    local -A open_net=()                            # SSID → "Open" Marker
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      sig="${line%%:*}";   line="${line#*:}"
      ssid="${line%%:*}";  line="${line#*:}"
      sec="${line%%:*}"
      [ -z "$ssid" ] && continue                    # Hidden SSIDs Need Manual Entry
      # Unescape nmcli's Terse-Mode Colons (\:) So the Menu Shows Real Names.
      ssid="${ssid//\\:/:}"
      sec="${sec//\\:/:}"
      if [ "$sec" = "--" ]; then
        sec="Open"
        open_net["$ssid"]=1
      else
        sec="Secured ($sec)"
      fi
      nets+=("$ssid" "$(printf '%-4s %-38s %s' "$sig" "$ssid" "$sec")")
    done < <(nmcli -t -f SIGNAL,SSID,SECURITY device wifi list 2>/dev/null \
             | sort -t: -k1,1rn | awk -F: '!seen[$2]++')

    if [ ${#nets[@]} -eq 0 ]; then
      whiptail --msgbox "No Wi-Fi Networks Found.\n\nMake Sure the Adapter Isn't rfkill-Blocked\n(Run: rfkill unblock all) And Try Again." 12 60 \
        --title "Artix — Wi-Fi" 3>&1 1>&2 2>&3 || return 1
      continue
    fi

    # Menu Height Caps at 24 Rows; whiptail Scrolls Longer Lists Internally.
    local menu_height=$(( ${#nets[@]} / 2 > 24 ? 24 : ${#nets[@]} / 2 ))
    local WIFI_SSID
    WIFI_SSID=$(whiptail --menu "Wi-Fi Networks (Strongest Signal First):" 28 78 "$menu_height" \
      "${nets[@]}" \
      --extra-button --extra-label "Rescan" \
      --title "Artix — Wi-Fi" 3>&1 1>&2 2>&3)
    local rc=$?
    if [ $rc -eq 1 ]; then return 0; fi              # Cancel → Ethernet Path
    if [ $rc -eq 3 ]; then continue; fi              # Rescan Button

    # Open Networks Skip the Password Prompt. Bail Out If the Menu Returned
    # Nothing (Shouldn't Happen — whiptail Cancels Are Handled Above).
    local psk=""
    if [ -z "$WIFI_SSID" ]; then
      continue
    elif [ -z "${open_net[$WIFI_SSID]:-}" ]; then
      while :; do
        psk=$(whiptail --passwordbox "Password For \"$WIFI_SSID\":" 10 60 "" \
          --title "Artix — Wi-Fi Password" 3>&1 1>&2 2>&3) || { psk=""; break; }
        [ ${#psk} -ge 8 ] || { whiptail --msgbox "Password Must Be At Least 8 Characters (WPA)." 9 50; continue; }
        break
      done
      [ -z "$psk" ] && continue                      # Escaped Password Prompt → Back to List
    fi

    step "Connecting To $WIFI_SSID"
    if [ -n "$psk" ]; then
      nmcli device wifi connect "$WIFI_SSID" password "$psk" >>"$LOG" 2>&1 || true
    else
      nmcli device wifi connect "$WIFI_SSID" >>"$LOG" 2>&1 || true
    fi

    if ping -c1 -W5 geo-mirror.chaotic.cx >/dev/null 2>&1; then
      log "Wi-Fi Connected: $WIFI_SSID"
      return 0
    fi
    whiptail --msgbox "Connection Failed Or No Internet.\nCheck the Password And Try Again." 10 55 \
      --title "Artix — Wi-Fi" 3>&1 1>&2 2>&3
  done
}

