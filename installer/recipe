Y=$'\e[1;33m'   # Yellow
D=$'\e[1;31m'   # Red
B=$'\e[1;34m'   # Blue
N=$'\e[0m'

banner() {
  echo -e "${R}"
  echo "  ██████╗  █████╗ ███╗   ██╗███████╗██╗      ██████╗ ███████╗"
  echo "  ██╔══██╗██╔══██╗████╗  ██║██╔════╝██║     ██╔══██╗██╔════╝"
  echo "  ██║  ██║███████║██╔██╗ ██║█████╗  ██║     ██║  ██║███████╗"
  echo "  ██║  ██║██╔══██║██║╚██╗██║██╔══╝  ██║     ██║  ██║╚════██║"
  echo "  ██████╔╝██║  ██║██║ ╚████║███████╗███████╗██████╔╝███████║"
  echo "  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝╚══════╝╚═════╝ ╚══════╝"
