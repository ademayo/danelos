#!/usr/bin/env bash
# ============================================================================
#  ██████╗  █████╗ ███╗   ██╗███████╗██╗      ██████╗ ███████╗
#  ██╔══██╗██╔══██╗████╗  ██║██╔════╝██║     ██╔══██╗██╔════╝
#  ██║  ██║███████║██╔██╗ ██║█████╗  ██║     ██║  ██║███████╗
#  ██║  ██║██╔══██║██║╚██╗██║██╔══╝  ██║     ██║  ██║╚════██║
#  ██████╔╝██║  ██║██║ ╚████║███████╗███████╗██████╔╝███████║
#  Stock Artix ISO (base-dinit), Bring Your Own Network Connection. As Root:
#
#    sudo pacman -Syu git --noconfirm && \
#      git clone https://github.com/ademayo/danelos.git && \
#      sudo ./danelos/installer/recipe
# ============================================================================
set -eEuo pipefail

VERSION="0.2"
MNT=/mnt
LOG=/tmp/install.log
SRC="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-.}")")/.."

# ----------------------------------------------------------------------------
# Look and Feel
# ----------------------------------------------------------------------------
R=$'\e[1;35m'   # Magenta
C=$'\e[1;36m'   # Cyan
G=$'\e[1;32m'   # Green
Y=$'\e[1;33m'   # Yellow
D=$'\e[1;31m'   # Red
B=$'\e[1;34m'   # Blue
N=$'\e[0m'

banner() {
  echo -e "${R}"
  echo "  ██████╗  █████╗ ███╗   ██╗███████╗██╗      ██████╗ ███████╗"
  echo "  ██╔══██╗██╔══██╗████╗  ██║██╔════╝██║     ██╔══██╗██╔════╝"
  echo "  ██║  ██║███████║██╔██╗ ██║█████╗  ██║     ██║  ██║███████╗"
  echo "  ██║  ██║██╔══██║██║╚██╗██║██╔══╝  ██║     ██║  ██║╚════██║"
  echo "  ██████╔╝██║  ██║██║ ╚████║███████╗███████╗██████╔╝███████║"
  echo "  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝╚══════╝╚═════╝ ╚══════╝"
  echo -e "${Y}  v${VERSION} — Stock ISO · Bring Your Own Network · The Whole Rig Will Be Wiped, No Take-Backs${N}"
}
log()  { echo -e "${G}::${N} $*" | tee -a "$LOG"; }
step() { echo -e "\n${C}==> ${B}$*${N}" | tee -a "$LOG"; }
warn() { echo -e "${Y} !! $*${N}" | tee -a "$LOG"; }
die()  { echo -e "${D}FATAL: $*${N}" | tee -a "$LOG" >&2; exit 1; }

# ----------------------------------------------------------------------------
# Preflight
# ----------------------------------------------------------------------------
[ "$(id -u)" = 0 ] || die "Run As Root — Boot The Stock ISO And Log In As The Live User."
grep -qs 'Artix' /etc/os-release || die "This Installer Must Run On Artix Linux."

# Stock Artix Live Detection: The Initramfs Mounts the Live Root Under
# /run/artix (iso-initcpio 'artix' Hook) And Boot Params Carry
# label=/overlay=livefs.
live_ok() {
  [ -d /run/artix ] && return 0
  grep -qs 'overlay=livefs\|label=ARTIX' /proc/cmdline && return 0
  mountpoint -q /run/artix/bootmnt 2>/dev/null
}

if ! live_ok; then
  die "Not Running From The Artix Live Environment. Boot The Stock Artix ISO."
fi

# ----------------------------------------------------------------------------
# Dependencies (Only What a Stock Artix ISO Lacks)
# ----------------------------------------------------------------------------
ensure_deps() {
  step "Checking Dependencies"
  # basestrap/artix-chroot/fstabgen Ship On Every Artix Live ISO (artools-base,
  # Dependency Of artix-live-base). whiptail/git Are On the Stock base-dinit
  # ISO; Anything Else Gets Pulled From the Repos.
  # sgdisk (gptfdisk) And cryptsetup Aren't On the Base ISO — Always Install
  # Them. The Rest Only When Missing. Failure Dies Loudly Here Instead of At
  # The First sgdisk/cryptsetup Call.
  pacman -Sy --noconfirm --needed gptfdisk cryptsetup >>"$LOG" 2>&1 \
    || die "gptfdisk/cryptsetup Install Failed — Check $LOG And Your Network Connection."
  local missing=()
  for c in whiptail vim git; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    log "Installing Missing ISO Tools: ${missing[*]}"
    pacman -Sy --noconfirm --needed libnewt vim git >>"$LOG" 2>&1 \
      || die "ISO Tools Install Failed (${missing[*]}) — Check $LOG."
  fi
  for c in whiptail sgdisk cryptsetup basestrap artix-chroot fstabgen git; do
    command -v "$c" >/dev/null 2>&1 || die "$c Unavailable — Install Libnewt, Gptfdisk, Cryptsetup, Artools-Base, Git First."
  done
}

