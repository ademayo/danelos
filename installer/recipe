log()  { echo -e "${G}::${N} $*" | tee -a "$LOG"; }
step() { echo -e "\n${C}==> ${B}$*${N}" | tee -a "$LOG"; }
warn() { echo -e "${Y} !! $*${N}" | tee -a "$LOG"; }
die()  { echo -e "${D}FATAL: $*${N}" | tee -a "$LOG" >&2; exit 1; }

# ----------------------------------------------------------------------------
# Preflight
# ----------------------------------------------------------------------------
[ "$(id -u)" = 0 ] || die "Run As Root — Boot The Custom ISO And Log In As The Live User."
grep -qs 'Artix' /etc/os-release || die "This Installer Must Run On Artix Linux."

# The custom ISO is the only supported install path; refuse anything else.
if [ ! -e /run/live ] && ! grep -qs 'boot=live' /proc/cmdline; then
  die "Not Running From The Custom ISO Live Environment. Boot The ISO Built By This Repo."
fi

# ----------------------------------------------------------------------------
# Dependencies (Only What A Bare Artix ISO Lacks)
# ----------------------------------------------------------------------------
ensure_deps() {
  step "Checking Dependencies"
  local missing=()
  for c in whiptail sgdisk curl vim pacstrap arch-chroot genfstab; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    log "Installing Missing ISO Tools: ${missing[*]}"
    pacman -S --noconfirm --needed libnewt gptfdisk curl vim arch-install-scripts >>"$LOG" 2>&1
  fi
  for c in whiptail sgdisk pacstrap arch-chroot genfstab; do
    command -v "$c" >/dev/null 2>&1 || die "$c Unavailable — Install Libnewt, Gptfdisk, Arch-Install-Scripts First."
  done
}

