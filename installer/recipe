# ----------------------------------------------------------------------------
# Disk Selection
# ----------------------------------------------------------------------------
select_disk() {
  step "Selecting Installation Disk"
  local items=() line
  while read -r line; do
    items+=("$line" "")
  done < <(lsblk -dn -e 7,11 -o NAME,SIZE,TYPE,MODEL)

  if [ ${#items[@]} -eq 0 ]; then
    die "No Disks Found."
  fi

  DISK=$(whiptail --menu "Install To Which Disk?\nEverything On It Will Be Erased:" \
    22 76 10 "${items[@]}" --title "Artix — Disk" 3>&1 1>&2 2>&3) || exit 1
  DISK="/dev/$DISK"

  local size model
  size=$(lsblk -dn -o SIZE "$DISK")
  model=$(lsblk -dn -o MODEL "$DISK" | xargs)

  whiptail --title "Artix — Final Confirmation" --yesno --defaultno \
"This Will Erase $DISK ($model, $size) And Install Artix:

  1  EFI System   512 MiB  FAT32  BOOT
  2  Linux Swap     4 GiB         Swap
  3  Linux Root   Rest     Btrfs  System  (@ And @home Subvolumes)

Proceed?" 16 70 || { log "Aborted At Confirmation."; exit 1; }
}

# ----------------------------------------------------------------------------
# Partition, Format, Mount
# ----------------------------------------------------------------------------
partition_disk() {
  step "Wiping And Partitioning $DISK"
  swapoff -a 2>/dev/null || true
  umount -R "$MNT" 2>/dev/null || true
  sync

  sgdisk --zap-all "$DISK" >>"$LOG" 2>&1
  sgdisk -n 1:0:+512M   -t 1:ef00 -c 1:BOOT   "$DISK" >>"$LOG" 2>&1
  sgdisk -n 2:0:+4G     -t 2:8200 -c 2:Swap   "$DISK" >>"$LOG" 2>&1
  sgdisk -n 3:0:0       -t 3:8300 -c 3:System "$DISK" >>"$LOG" 2>&1
  partx -a "$DISK" >>"$LOG" 2>&1 || true   # Ensure Partition Nodes Exist
  # Fallback For Environments Where udev Doesn't Populate Partition Nodes (Rare)
  local _p _node _mj _mn
  for _p in "$DISK"p1 "$DISK"p2 "$DISK"p3; do
    [ -e "$_p" ] && continue
    [ -r "/sys/block/$(basename "$DISK")/$(basename "$_p")/dev" ] || continue
    IFS=: read -r _mj _mn < "/sys/block/$(basename "$DISK")/$(basename "$_p")/dev"
    mknod "$_p" b "$_mj" "$_mn" 2>/dev/null || true
  done

  log "Formatting"
  local part1 part2 part3
  if [[ "$DISK" == *nvme* || "$DISK" == *mmcblk* || "$DISK" == *loop* ]]; then
    part1="${DISK}p1"; part2="${DISK}p2"; part3="${DISK}p3"
  else
    part1="${DISK}1"; part2="${DISK}2"; part3="${DISK}3"
  fi
  mkfs.fat -F32 -n BOOT   "$part1" >>"$LOG" 2>&1
  mkswap -L Swap          "$part2" >>"$LOG" 2>&1
  mkfs.btrfs -f -L System "$part3" >>"$LOG" 2>&1

  log "Creating Btrfs Subvolumes @ And @home"
  mount "$part3" $MNT
  btrfs subvolume create /mnt/@   >>"$LOG" 2>&1
  btrfs subvolume create /mnt/@home >>"$LOG" 2>&1
  umount /mnt

  log "Mounting"
  mount -o subvol=/@,compress=zstd "$part3" $MNT
  mkdir -p /mnt/boot /mnt/home
  mount "$part1" /mnt/boot
  mount -o subvol=/@home,compress=zstd "$part3" /mnt/home
  swapon "$part2"
}

# ----------------------------------------------------------------------------
# Target System
write_keyfiles() {
  step "Writing System Key Files"
  mkdir -p /mnt/etc
  printf '%s\n' "$HOSTNAME" > /mnt/etc/hostname
  cat > /mnt/etc/hosts <<EOF
127.0.0.1  localhost
::1        localhost
127.0.1.1  $HOSTNAME.localdomain $HOSTNAME
EOF
  cat > /mnt/etc/vconsole.conf <<EOF
KEYMAP=${KEYMAP:-us}
EOF
  ln -sf "/usr/share/zoneinfo/$TIMEZONE" /mnt/etc/localtime
  echo "KEYMAP=${KEYMAP:-us}" > /etc/vconsole.conf

  # Locales: Enable The ISO's Active Locale Plus en_US As A Floor
  # (Runs Pre-pacstrap In The Dry-Run; locale.gen May Not Exist Yet — pacstrap
  # Regenerates It, And The en_US Default Below Holds Either Way)
  local iso_locale
  iso_locale=$(locale | grep -oP 'LANG=\K\S+' | head -1 || true)
  if [ -f /mnt/etc/locale.gen ]; then
    sed -i '/^#en_US.UTF-8 UTF-8/s/^#//' /mnt/etc/locale.gen
    if [ -n "${iso_locale:-}" ] && ! grep -qs "^${iso_locale%%.*} " /mnt/etc/locale.gen; then
      echo "${iso_locale} UTF-8" >> /mnt/etc/locale.gen
    fi
  fi
  echo "LANG=${iso_locale:-en_US.UTF-8}" > /mnt/etc/locale.conf
}

# ----------------------------------------------------------------------------
# Target Packages
# ----------------------------------------------------------------------------
pacstrap_target() {
  step "Installing Base System (This Takes A While — Grab A Coffee)"
  # Repo Package Lists Minus What pacstrap Needs Pulled Explicitly
  local -a base_pkgs=() line
  while IFS= read -r line; do
    line="${line%%#*}"; line="$(echo "$line" | xargs)" || true
    [ -z "$line" ] && continue
    case "$line" in
      base|base-devel|linux|linux-firmware|linux-headers|grub|efibootmgr|os-prober|mkinitcpio) ;;
      *) base_pkgs+=("$line") ;;
    esac
  done < "$SRC/packages/base.packages"

  pacman -Sy archlinux-keyring artix-keyring >>"$LOG" 2>&1 || true
  pacstrap -K $MNT base base-devel linux linux-firmware linux-headers \
    grub efibootmgr os-prober mkinitcpio btrfs-progs dosfstools "${base_pkgs[@]}" \
    >>"$LOG" 2>&1

  # Chaotic-AUR (For ungoogled-chromium-bin, papirus-folders)
  cat >> /mnt/etc/pacman.conf <<'EOF'

[chaotic-aur]
SigLevel = Optional TrustAll
Server = https://cdn-mirror.chaotic.cx/$repo/$arch
Server = https://geo-mirror.chaotic.cx/$repo/$arch
EOF
  if ! grep -qs '^\[extra\]' /mnt/etc/pacman.conf; then
    cat >> /mnt/etc/pacman.conf <<'EOF'

# Last-Ditch: Arch Extra, Used Only For Packages Artix And Chaotic Lack.
[extra]
SigLevel = PackageRequired
Include = /etc/pacman.d/arch-mirrorlist
EOF
  fi
  [ -f /etc/pacman.d/arch-mirrorlist ] && cp /etc/pacman.d/arch-mirrorlist /mnt/etc/pacman.d/ || true

  # Desktop Packages (hyprland, waybar, alacritty, greetd, browsers, ...)
  step "Installing Desktop Packages"
  local -a desk_pkgs=()
  while IFS= read -r line; do
    line="${line%%#*}"; line="$(echo "$line" | xargs)" || true
    [ -z "$line" ] && continue
    desk_pkgs+=("$line")
  done < "$SRC/packages/desktop.packages"
  arch-chroot $MNT pacman -S --noconfirm --needed --asexplicit "${desk_pkgs[@]}" >>"$LOG" 2>&1

  arch-chroot $MNT pacman -Syu --noconfirm --needed >>"$LOG" 2>&1
}

make_fstab() {
  step "Generating Fstab"
  mkdir -p /mnt/etc
  genfstab -U $MNT > /mnt/etc/fstab

  # genfstab Can Pick Up The ISO's Own Swap Entry; Keep Only Target-Disk Lines
  local swappart="${DISK}2"; [[ "$DISK" == *nvme* || "$DISK" == *mmcblk* ]] && swappart="${DISK}p2"
  local swapuuid
  swapuuid=$(lsblk -no UUID "$swappart")
  grep -v 'swap' /mnt/etc/fstab > /tmp/fstab.clean
  echo "UUID=$swapuuid none swap defaults 0 0" >> /tmp/fstab.clean
  mv /tmp/fstab.clean /mnt/etc/fstab

  # Normalize Btrfs Options: Add Compression, Keep Subvol
  grep -qs 'compress=zstd' /mnt/etc/fstab || \
    sed -i -E 's|(btrfs[^\n]*subvol=)|\1compress=zstd,|' /mnt/etc/fstab
  log "fstab:"
  sed 's/^/    /' /mnt/etc/fstab
}

configure_users() {
  step "Creating Users"
  printf '%s\n' "$ROOT_PW" "$ROOT_PW" | arch-chroot $MNT passwd root >/dev/null

  # Login Shell: zsh For The User, root Keeps bash
  arch-chroot $MNT useradd -m -G wheel -s /bin/zsh -c "$REALNAME" "$USERNAME"
  printf '%s\n' "$USER_PW" "$USER_PW" | arch-chroot $MNT passwd "$USERNAME" >/dev/null

  # Common/Necessary Groups: Sudo Via Wheel, Plus Classic Device Access
  arch-chroot $MNT usermod -aG audio,video,optical,storage,lp,input,network "$USERNAME"

  # Sudo For Wheel (System-Wide)
  echo '%wheel ALL=(ALL:ALL) ALL' > /mnt/etc/sudoers.d/00-wheel
  chmod 440 /mnt/etc/sudoers.d/00-wheel

  # Ensure Wheel Exists Even On Minimal Installs
  if ! grep -qs '^wheel:' /mnt/etc/group; then
    arch-chroot $MNT groupadd -f wheel
  fi

  # /bin/sh: dash (POSIX-Fast), bash Stays Available For root And Scripts
  arch-chroot $MNT ln -sfn dash /usr/bin/sh
}

install_grub() {
  step "Installing GRUB"
  # Make Sure The Initramfs Includes btrfs
  sed -i 's/^MODULES=()/MODULES=(btrfs)/' /mnt/etc/mkinitcpio.conf
  grep -qs '^MODULES=.*btrfs' /mnt/etc/mkinitcpio.conf || \
    sed -i 's/^MODULES=(\(.*\))/MODULES=(btrfs \1)/' /mnt/etc/mkinitcpio.conf
  arch-chroot $MNT mkinitcpio -P >>"$LOG" 2>&1

  arch-chroot $MNT grub-install --target=x86_64-efi --efi-directory=/boot \
    --bootloader-id=Artix --recheck >>"$LOG" 2>&1
  arch-chroot $MNT grub-mkconfig -o /boot/grub/grub.cfg >>"$LOG" 2>&1
}

enable_services() {
  step "Enabling Services (dinit)"
  for svc in NetworkManager bluetoothd avahi-daemon sshd cronie turnstiled greetd userspawn; do
    if [ -e "/mnt/etc/dinit.d/$svc" ]; then
      ln -sfn "/mnt/etc/dinit.d/$svc" "/mnt/etc/dinit.d/boot.d/$svc" 2>/dev/null || true
    fi
  done
  # User dinit Services (pipewire, dbus) Via userspawn
  local home_dir="/mnt/home/$USERNAME"
  if [ -d "$home_dir" ]; then
    install -d -m755 "$home_dir/.config/dinit.d/boot.d"
    for s in dbus pipewire pipewire-pulse wireplumber; do
      [ -e "/mnt/etc/dinit.d/user/$s" ] && ln -sfn "/mnt/etc/dinit.d/user/$s" "$home_dir/.config/dinit.d/boot.d/$s"
    done
    chown -R "$(stat -c %u /mnt/home/$USERNAME)" "$home_dir/.config"
  fi
  # Machine ID For dbus/elogind
  arch-chroot $MNT dbus-uuidgen --ensure >/dev/null 2>&1 || true
  [ -f /mnt/var/lib/dbus/machine-id ] && [ ! -f /mnt/etc/machine-id ] && \
    cp /mnt/var/lib/dbus/machine-id /mnt/etc/machine-id || true
}
# ----------------------------------------------------------------------------
# Desktop Config Layer
# ----------------------------------------------------------------------------
deploy_configs() {
  # The Config Layer Ships Inside The Custom ISO
  [ -d "$SRC/conf" ] || die "Config Layer Missing From The ISO — Rebuild It."

  step "Deploying Desktop Configs"
  local u_home="/mnt/home/$USERNAME"
  install -d -m755 "$u_home"/.config/{hypr,waybar,alacritty,rofi,wlogout,gtk-3.0,gtk-4.0,qt6ct,fontconfig,dinit} "$u_home"/.local/bin

  cp -r "$SRC"/conf/hypr/.    "$u_home/.config/hypr/"
  cp -r "$SRC"/conf/waybar/.  "$u_home/.config/waybar/"
  cp -r "$SRC"/conf/alacritty/. "$u_home/.config/alacritty/"
  cp -r "$SRC"/conf/rofi/.    "$u_home/.config/rofi/"
  cp -r "$SRC"/conf/wlogout/. "$u_home/.config/wlogout/"
  cp -r "$SRC"/conf/gtk/.     "$u_home/.config/"
  cp -r "$SRC"/conf/qt/.      "$u_home/.config/qt6ct/"
  cp -r "$SRC"/conf/userspawn/. "$u_home/.config/dinit/"
  cp "$SRC"/conf/zsh/zshrc    "$u_home/.zshrc"
  cp "$SRC"/conf/vim/vimrc    "$u_home/.vimrc"
  install -Dm755 "$SRC"/conf/bin/keybind-cheatsheet "$u_home/.local/bin/keybind-cheatsheet"

  chown -R "$(stat -c %u "$u_home")":"$(stat -c %g "$u_home")" "$u_home/.config" "$u_home/.local/bin" "$u_home/.vimrc" "$u_home/.zshrc"

  install -Dm644 "$SRC"/system/greetd/config.toml /mnt/etc/greetd/config.toml
  install -Dm644 "$SRC"/system/greetd/pam-greetd    /mnt/etc/pam.d/greetd

  install -d /mnt/usr/share/backgrounds
  cp "$SRC"/wallpapers/*.jpg /mnt/usr/share/backgrounds/

  # Dark Folders For Papirus Icons
  arch-chroot $MNT sudo -u "$USERNAME" papirus-folders -C ePapirus-Dark --theme Papirus-Dark >/dev/null 2>&1 || true
}

# ----------------------------------------------------------------------------
# Fin
# ----------------------------------------------------------------------------
finish() {
  step "Unmounting"
  sync
  umount -R /mnt 2>/dev/null || true
  local swappart="${DISK}2"; [[ "$DISK" == *nvme* || "$DISK" == *mmcblk* ]] && swappart="${DISK}p2"
  swapoff "$swappart" 2>/dev/null || true

  whiptail --title "Artix — Done" --msgbox "Install Complete. Reboot And Remove The ISO.

User:      $USERNAME
Hostname:  $HOSTNAME
Timezone:  $TIMEZONE
