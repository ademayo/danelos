# ----------------------------------------------------------------------------
# Disk Selection
# ----------------------------------------------------------------------------
select_disk() {
  step "Selecting Installation Disk"
  local items=() line name
  while read -r line; do
    name="${line%% *}"
    items+=("$name" "$line")
  done < <(lsblk -dn -e 7,11 -o NAME,SIZE,TYPE,MODEL)

  if [ ${#items[@]} -eq 0 ]; then
    die "No Disks Found."
  fi

  DISK=$(whiptail --menu "Install To Which Disk?\nEverything On It Will Be Erased:" \
    22 76 10 "${items[@]}" --title "Artix — Disk" 3>&1 1>&2 2>&3) || exit 1
  DISK="/dev/$DISK"

  local size model
  size=$(lsblk -dn -o SIZE "$DISK")
  model=$(lsblk -dn -o MODEL "$DISK" | xargs)

  local layout="  1  EFI System   512 MiB  FAT32  BOOT (Unencrypted)
  2  Linux Root   Rest     LUKS2  cryptsystem
     └ Btrfs     Rest            System  (@ And @home Subvolumes, Encrypted Swapfile)"

  whiptail --title "Artix — Final Confirmation" --yesno --defaultno \
"This Will Erase $DISK ($model, $size) And Install Artix:

$layout

LUKS2 Encryption: ON — Disk Passphrase At Boot.
Firewall: ufw ON (Deny Incoming).
Locale: $LOCALE    Timezone: $TIMEZONE

Proceed?" 18 70 || { log "Aborted At Confirmation."; exit 1; }
  sync
}

partition_disk() {
  step "Partitioning And Opening LUKS Container"

  # Zap and recreate GPT. Use --no-reread so sgdisk does not try to inform
  # the kernel itself; we sync explicitly afterwards.
  sgdisk --zap-all "$DISK" >>"$LOG" 2>&1
  sgdisk -n 1:0:+512M -t 1:ef00 -c 1:BOOT "$DISK" >>"$LOG" 2>&1
  sgdisk -n 2:0:0     -t 2:8304 -c 2:cryptsystem "$DISK" >>"$LOG" 2>&1

  # Tell the kernel about the new partition table and wait until the nodes
  # appear. On a real disk this is fast; on loopback or slow media we retry.
  blockdev --rereadpt "$DISK" >>"$LOG" 2>&1 || true
  partx -u "$DISK" >>"$LOG" 2>&1 || true
  local _p _node _mj _mn _tries
  for _p in "$DISK"p1 "$DISK"p2 "$DISK"p3; do
    _tries=0
    while [ ! -e "$_p" ] && [ "$_tries" -lt 30 ]; do
      sleep 0.2
      blockdev --rereadpt "$DISK" >>"$LOG" 2>&1 || true
      partx -u "$DISK" >>"$LOG" 2>&1 || true
      # Direct node creation fallback: some live ISOs do not spawn udev
      # partition events for certain block devices.
      if [ ! -e "$_p" ] && [ -r "/sys/block/$(basename "$DISK")/$(basename "$_p")/dev" ]; then
        IFS=: read -r _mj _mn < "/sys/block/$(basename "$DISK")/$(basename "$_p")/dev"
        [ -e "$_p" ] || mknod "$_p" b "$_mj" "$_mn" 2>/dev/null || true
      fi
      _tries=$((_tries + 1))
    done
  done

  # File Scope: part2 Is Read Back In write_keyfiles And install_grub (crypttab
  # UUID + GRUB cryptdevice). Locals Die With This Function.
  part1=; part2=; part3=
  if [[ "$DISK" == *nvme* || "$DISK" == *mmcblk* || "$DISK" == *loop* ]]; then
    part1="${DISK}p1"; part2="${DISK}p2"; part3="${DISK}p3"
  else
    part1="${DISK}1"; part2="${DISK}2"; part3="${DISK}3"
  fi

  [ -e "$part1" ] || die "ESP Partition Node $part1 Did Not Appear — See $LOG."
  [ -e "$part2" ] || die "LUKS Partition Node $part2 Did Not Appear — See $LOG."

  mkfs.fat -F32 -n BOOT "$part1" >>"$LOG" 2>&1 \
    || die "mkfs.fat Failed For $part1 — See $LOG."

  # Pre-load crypto modules so luksFormat/open don't fail silently on a bare
  # live kernel (matches the Artix FDE guide's `cryptsetup benchmark` step).
  cryptsetup benchmark >>"$LOG" 2>&1 || true

  # Argon2id can default to hundreds of MiB and cause an OOM/hang on low-RAM
  # live media. Cap memory cost to 128 MiB; cryptsetup benchmark will tune the
  # iteration count around that limit. Still stronger than pbkdf2.
  log "Encrypting $part2 (LUKS2, Argon2id, 128 MiB Memory Cap)"
  printf '%s' "$LUKS_PW" | cryptsetup luksFormat --type luks2 \
    --pbkdf argon2id --pbkdf-memory 131072 --batch-mode --key-file - "$part2" >>"$LOG" 2>&1 \
    || die "cryptsetup luksFormat Failed For $part2 — See $LOG."

  log "Opening LUKS Container"
  local crypt_rc
  printf '%s' "$LUKS_PW" | cryptsetup open --type luks2 \
    --key-file - "$part2" cryptsystem >>"$LOG" 2>&1 || crypt_rc=$?
  if [ "${crypt_rc:-0}" -ne 0 ]; then
    echo "cryptsetup open exit code: ${crypt_rc:-0}" >>"$LOG"
    die "cryptsetup open Failed For $part2 — See $LOG."
  fi
  part3="/dev/mapper/cryptsystem"

  log "Formatting $part3 As Btrfs"
  mkfs.btrfs -f -L cryptroot "$part3" >>"$LOG" 2>&1 \
    || die "mkfs.btrfs Failed For $part3 — See $LOG."

  log "Creating Btrfs Subvolumes @ And @home"
  mount "$part3" $MNT
  btrfs subvolume create /mnt/@   >>"$LOG" 2>&1
  btrfs subvolume create /mnt/@home >>"$LOG" 2>&1
  umount /mnt

  log "Mounting"
  mount -o subvol=/@,compress=zstd "$part3" $MNT
  mkdir -p /mnt/boot /mnt/home /mnt/swap
  mount "$part1" /mnt/boot
  mount -o subvol=/@home,compress=zstd "$part3" /mnt/home

  # 4 GiB Encrypted Swapfile (mkswapfile Sets NOCOW — Required For swapon)
  log "Creating 4 GiB Encrypted Swapfile"
  btrfs filesystem mkswapfile --size 4g --uuid clear /mnt/swap/swapfile >>"$LOG" 2>&1
  [ -s /mnt/swap/swapfile ] || die "Swapfile Creation Failed — See $LOG."
  chmod 0600 /mnt/swap/swapfile
  swapon /mnt/swap/swapfile || die "swapon Failed For Encrypted Swapfile — See $LOG."
}

# ----------------------------------------------------------------------------
# Target System
# ----------------------------------------------------------------------------
write_keyfiles() {
  step "Writing System Key Files"
  mkdir -p /mnt/etc
  cat > /mnt/etc/hosts <<EOF
127.0.0.1  localhost
::1        localhost
127.0.1.1  $HOSTNAME.localdomain $HOSTNAME
EOF
  cat > /mnt/etc/vconsole.conf <<EOF
KEYMAP=${KEYMAP:-us}
EOF
  ln -sf "/usr/share/zoneinfo/$TIMEZONE" /mnt/etc/localtime
  echo "KEYMAP=${KEYMAP:-us}" > /etc/vconsole.conf

  # Locale: Written To the Target Now; locale.gen Un-commented and locale-gen
  # Runs Post-basestrap (The Target File Only Exists After glibc Installs).
  echo "LANG=$LOCALE" > /mnt/etc/locale.conf
  # Post-basestrap, In Target: Enable the Picked Locale Plus en_US As a Floor.
  POST_LOCALE_GEN='
sed -i "s/^#@LOCALE@ UTF-8/@LOCALE@ UTF-8/" /etc/locale.gen
sed -i "s/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/" /etc/locale.gen
grep -qs "^@LOCALE@ UTF-8" /etc/locale.gen || echo "@LOCALE@ UTF-8" >> /etc/locale.gen
locale-gen
'
  POST_LOCALE_GEN="${POST_LOCALE_GEN//@LOCALE@/$LOCALE}"

  # LUKS: crypttab So the Root Container Is Openable Post-boot (e.g. LVM /
  # Rescue), Though the Initramfs Hook Is the Real Unlock Path.
  local luksuuid
  luksuuid=$(cryptsetup luksUUID "$part2")
  echo "cryptsystem UUID=$luksuuid none luks,discard" > /mnt/etc/crypttab
  # Initramfs Unlock Config: Ask For the Passphrase Once At Boot.
  echo "cryptsystem UUID=$luksuuid" > /mnt/etc/crypttab.initramfs
}

# ----------------------------------------------------------------------------
# Target Packages
# ----------------------------------------------------------------------------
basestrap_target() {
  step "Installing Base System (This Takes A While — Grab A Coffee)"
  # Repo Package Lists Minus What basestrap Needs Pulled Explicitly
  local -a base_pkgs=() line
  while IFS= read -r line; do
    line="${line%%#*}"; line="$(echo "$line" | xargs)" || true
    [ -z "$line" ] && continue
    case "$line" in
      base|base-devel|linux|linux-firmware|linux-headers|grub|efibootmgr|os-prober|mkinitcpio) ;;
      *) base_pkgs+=("$line") ;;
    esac
  done < "$SRC/packages/base.packages"

  # Mandatory Extras: LUKS (cryptsetup For crypttab + luksUUID), ufw.
  local -a extra_pkgs=(cryptsetup ufw ufw-dinit iptables)

  pacman -Sy archlinux-keyring artix-keyring >>"$LOG" 2>&1 || true
  basestrap -K $MNT base base-devel linux linux-firmware linux-headers \
    grub efibootmgr os-prober mkinitcpio btrfs-progs dosfstools \
    "${extra_pkgs[@]}" "${base_pkgs[@]}" \
    >>"$LOG" 2>&1

  # Locale: The Target's locale.gen Now Exists — Enable Pick + en_US, Generate.
  step "Generating Locale $LOCALE"
  artix-chroot $MNT bash -c "POST_LOCALE_GEN=$(printf '%q' "$POST_LOCALE_GEN"); eval \"\$POST_LOCALE_GEN\""

  # Chaotic-AUR (For ungoogled-chromium-bin, papirus-folders)
  cat >> /mnt/etc/pacman.conf <<'EOF'

[chaotic-aur]
SigLevel = Optional TrustAll
Server = https://cdn-mirror.chaotic.cx/$repo/$arch
Server = https://geo-mirror.chaotic.cx/$repo/$arch
EOF
  if ! grep -qs '^\[extra\]' /mnt/etc/pacman.conf; then
    # Last-Ditch: Arch Extra, Used Only for Packages Artix and Chaotic Lack.
    # The Stock ISO Lacks artix-archlinux-support (No arch-mirrorlist); Point
    # Straight At the Arch Geo Mirror Instead of an Include.
    cat >> /mnt/etc/pacman.conf <<'EOF'

[extra]
SigLevel = PackageRequired
Server = https://geo.mirror.pkgbuild.com/extra/os/$arch
EOF
    if [ -f /etc/pacman.d/arch-mirrorlist ]; then
      cp /etc/pacman.d/arch-mirrorlist /mnt/etc/pacman.d/
      sed -i 's|^Server = https://geo.mirror.pkgbuild.com/extra/os/$arch|Include = /etc/pacman.d/arch-mirrorlist|' /mnt/etc/pacman.conf
    fi
  fi

  # Desktop Packages (hyprland, waybar, alacritty, sddm, browsers, ...)
  step "Installing Desktop Packages"
  local -a desk_pkgs=()
  while IFS= read -r line; do
    line="${line%%#*}"; line="$(echo "$line" | xargs)" || true
    [ -z "$line" ] && continue
    desk_pkgs+=("$line")
  done < "$SRC/packages/desktop.packages"
  artix-chroot $MNT pacman -Sy --noconfirm --needed --asexplicit "${desk_pkgs[@]}" >>"$LOG" 2>&1 \
    || die "Desktop Package Install Failed — Check $LOG."

  artix-chroot $MNT pacman -Syu --noconfirm --needed >>"$LOG" 2>&1
}

make_fstab() {
  step "Generating Fstab"
  mkdir -p /mnt/etc
  fstabgen -U $MNT > /mnt/etc/fstab

  # fstabgen Can Pick Up the ISO's Own Swap Entry; Keep Only Target-Disk Lines.
  # Swapfile Lives On the Encrypted Btrfs; Plain Directory On the Root Subvol.
  grep -v 'swap' /mnt/etc/fstab > /tmp/fstab.clean
  echo "/swap/swapfile none swap defaults 0 0" >> /tmp/fstab.clean
  mv /tmp/fstab.clean /mnt/etc/fstab

  # Normalize Btrfs Options: Add Compression, Keep subvol
  grep -qs 'compress=zstd' /mnt/etc/fstab || \
    sed -i -E 's|(btrfs[^\n]*subvol=)|\1compress=zstd,|' /mnt/etc/fstab
  log "fstab:"
  sed 's/^/    /' /mnt/etc/fstab
}

configure_users() {
  step "Creating Users"
  printf '%s\n' "$ROOT_PW" "$ROOT_PW" | artix-chroot $MNT passwd root >/dev/null

  # Login Shell: zsh For the User, root Keeps bash
  artix-chroot $MNT useradd -m -G wheel -s /bin/zsh -c "$REALNAME" "$USERNAME"
  printf '%s\n' "$USER_PW" "$USER_PW" | artix-chroot $MNT passwd "$USERNAME" >/dev/null

  # Common/Necessary Groups: Sudo Via Wheel, Plus Classic Device Access
  artix-chroot $MNT usermod -aG audio,video,optical,storage,lp,input,network "$USERNAME"

  # Sudo For Wheel (System-Wide)
  echo '%wheel ALL=(ALL:ALL) ALL' > /mnt/etc/sudoers.d/00-wheel
  chmod 440 /mnt/etc/sudoers.d/00-wheel

  # Ensure Wheel Exists Even On Minimal Installs
  if ! grep -qs '^wheel:' /mnt/etc/group; then
    artix-chroot $MNT groupadd -f wheel
  fi

  # /bin/sh: dash (POSIX-Fast), bash Stays Available for root and Scripts
  artix-chroot $MNT ln -sfn dash /usr/bin/sh
}

install_grub() {
  step "Installing GRUB"
  # Initramfs: Btrfs + encrypt + keyboard/keymap Hooks (Disk Is Always LUKS2).
  # encrypt Runs the Passphrase Prompt Once — No Re-entry At the Greeter.
  # encrypt Must Come After block, Before filesystems.
  # keyboard/keymap/consolefont Let the Initramfs Prompt Honor Non-US Keymaps.
  # Replace the entire HOOKS line with the Artix FDE standard order.
  # encrypt must sit between block and filesystems; keyboard/keymap/consolefont
  # make the passphrase prompt honor the chosen console keymap.
  sed -i 's/^HOOKS=.*/HOOKS=(base udev autodetect modconf block keyboard keymap consolefont encrypt filesystems fsck)/' /mnt/etc/mkinitcpio.conf
  grep -qs '^HOOKS=' /mnt/etc/mkinitcpio.conf || \
    echo 'HOOKS=(base udev autodetect modconf block keyboard keymap consolefont encrypt filesystems fsck)' >> /mnt/etc/mkinitcpio.conf

  # btrfs module must be in the initramfs so the root subvolume is mountable.
  if ! grep -qs '^MODULES=.*\bbtrfs\b' /mnt/etc/mkinitcpio.conf; then
    if grep -qs '^MODULES=()' /mnt/etc/mkinitcpio.conf; then
      sed -i 's/^MODULES=()/MODULES=(btrfs)/' /mnt/etc/mkinitcpio.conf
    else
      sed -i -E 's/^MODULES=\((.*)\)$/MODULES=(btrfs \1)/' /mnt/etc/mkinitcpio.conf
    fi
  fi

  # Regenerate initramfs with the encrypt/btrfs hooks before installing GRUB.
  # The Artix FDE guide does this explicitly; otherwise the kernel cannot
  # unlock the root partition on first boot.
  artix-chroot $MNT mkinitcpio -P >>"$LOG" 2>&1 \
    || die "mkinitcpio Failed — See $LOG."

  local luksuuid
  luksuuid=$(cryptsetup luksUUID "$part2")
  artix-chroot $MNT grub-install --target=x86_64-efi --efi-directory=/boot \
    --bootloader-id=Artix --recheck >>"$LOG" 2>&1 \
    || die "grub-install Failed — See $LOG."
  # Kernel Cmdline Points the encrypt Hook At the Container By UUID.
  sed -i "s|GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"cryptdevice=UUID=$luksuuid:cryptsystem root=/dev/mapper/cryptsystem\"|" \
    /mnt/etc/default/grub
  # Allow GRUB to read encrypted devices if /boot ever moves onto the LUKS volume.
  sed -i 's/^#GRUB_ENABLE_CRYPTODISK=y/GRUB_ENABLE_CRYPTODISK=y/; s/^GRUB_ENABLE_CRYPTODISK=.*/GRUB_ENABLE_CRYPTODISK=y/' /mnt/etc/default/grub
  artix-chroot $MNT grub-mkconfig -o /boot/grub/grub.cfg >>"$LOG" 2>&1 \
    || die "grub-mkconfig Failed — See $LOG."
}

enable_services() {
  # dinit boot.d must exist before we link services into it.
  install -d -m755 /mnt/etc/dinit.d/boot.d

  # ufw Is Mandatory — Its dinit Service Runs `ufw enable` At Every Boot.
  for svc in NetworkManager ufw bluetoothd avahi-daemon sshd cronie sddm userspawn; do
    if [ -e "/mnt/etc/dinit.d/$svc" ]; then
      ln -sfn "/etc/dinit.d/$svc" "/mnt/etc/dinit.d/boot.d/$svc" 2>/dev/null || true
    fi
  done
  # User dinit Services (pipewire, dbus) Via userspawn
  local home_dir="/mnt/home/$USERNAME"
  if [ -d "$home_dir" ]; then
    install -d -m755 "$home_dir/.config/dinit.d/boot.d"
    for s in dbus pipewire pipewire-pulse wireplumber; do
      [ -e "/mnt/etc/dinit.d/user/$s" ] && ln -sfn "/etc/dinit.d/user/$s" "$home_dir/.config/dinit.d/boot.d/$s"
    done
    chown -R "$(stat -c %u /mnt/home/$USERNAME)" "$home_dir/.config"
  fi
  # Machine ID For dbus/elogind
  artix-chroot $MNT dbus-uuidgen --ensure >/dev/null 2>&1 || true
  [ -f /mnt/var/lib/dbus/machine-id ] && [ ! -f /mnt/etc/machine-id ] && \
    cp /mnt/var/lib/dbus/machine-id /mnt/etc/machine-id || true
}

# ----------------------------------------------------------------------------
# Desktop Config Layer
# ----------------------------------------------------------------------------
deploy_configs() {
  # The Config Layer Lives In the Cloned Repo, Sibling To installer/
  [ -d "$SRC/conf" ] || die "Config Layer Missing Next To The Installer — Clone the Full Repo (git clone), Not a Single File."

  step "Deploying Desktop Configs"
  local u_home="/mnt/home/$USERNAME"
  install -d -m755 "$u_home"/.config/{hypr,waybar,alacritty,rofi,wlogout,gtk-3.0,gtk-4.0,qt6ct,fontconfig,dinit} "$u_home"/.local/bin

  cp -r "$SRC"/conf/hypr/.    "$u_home/.config/hypr/"
  cp -r "$SRC"/conf/waybar/.  "$u_home/.config/waybar/"
  cp -r "$SRC"/conf/alacritty/. "$u_home/.config/alacritty/"
  cp -r "$SRC"/conf/rofi/.    "$u_home/.config/rofi/"
  cp -r "$SRC"/conf/wlogout/. "$u_home/.config/wlogout/"
  cp -r "$SRC"/conf/gtk/.     "$u_home/.config/"
  cp -r "$SRC"/conf/qt/.      "$u_home/.config/qt6ct/"
  cp "$SRC"/conf/zsh/zshrc    "$u_home/.zshrc"
  cp "$SRC"/conf/vim/vimrc    "$u_home/.vimrc"
  install -Dm755 "$SRC"/conf/bin/keybind-cheatsheet "$u_home/.local/bin/keybind-cheatsheet"

  chown -R "$(stat -c %u "$u_home")":"$(stat -c %g "$u_home")" "$u_home/.config" "$u_home/.local/bin" "$u_home/.vimrc" "$u_home/.zshrc"

  # SDDM: Bundled Overrides + Arc Dark Theme (Replaces the Stock Configs)
  install -Dm644 "$SRC"/system/sddm/sddm.conf /mnt/etc/sddm.conf.d/danelos.conf
  mkdir -p /mnt/usr/share/sddm/themes/arc-dark
  cp -r "$SRC"/system/sddm/themes/arc-dark/. /mnt/usr/share/sddm/themes/arc-dark/

  install -d /mnt/usr/share/backgrounds
  cp "$SRC"/wallpapers/*.jpg /mnt/usr/share/backgrounds/

  # Dark Folders For Papirus Icons
  artix-chroot $MNT sudo -u "$USERNAME" papirus-folders -C ePapirus-Dark --theme Papirus-Dark >/dev/null 2>&1 || true
}

configure_firewall() {
  step "Configuring ufw Firewall"
  # Defaults: Deny Incoming, Allow Outgoing, Deny Routed. IPv6 On.
  sed -i 's/^ENABLED=no/ENABLED=yes/' /mnt/etc/ufw/ufw.conf
  sed -i 's/^IPV6=no/IPV6=yes/' /mnt/etc/default/ufw
  # Seed the Rules File With the Default Policy (ufw-dinit Runs `ufw enable`
  # At Boot, Which Reloads These).
  artix-chroot $MNT ufw --force reset >>"$LOG" 2>&1 || true
  artix-chroot $MNT ufw default deny incoming >>"$LOG" 2>&1
  artix-chroot $MNT ufw default allow outgoing >>"$LOG" 2>&1
  # Loopback + NetworkManager DHCP/RA Must Never Be Blocked.
  artix-chroot $MNT ufw allow in on lo >>"$LOG" 2>&1
  artix-chroot $MNT ufw allow out on lo >>"$LOG" 2>&1
  artix-chroot $MNT ufw allow in proto udp from any port 67 to any port 68 >>"$LOG" 2>&1
  artix-chroot $MNT ufw allow in proto ipv6 from fe80::/10 >>"$LOG" 2>&1
  artix-chroot $MNT ufw --force enable >>"$LOG" 2>&1
  log "ufw Status (Chroot):"
  artix-chroot $MNT ufw status verbose | sed 's/^/    /' | tee -a "$LOG"
}

# ----------------------------------------------------------------------------
# Fin
# ----------------------------------------------------------------------------
finish() {
  # Swap Off FIRST — An Active Swapfile Holds the Btrfs Mount And LUKS
  # Container Open, So umount/close Would Fail After It.
  swapoff /mnt/swap/swapfile 2>/dev/null || true
  umount -R /mnt 2>/dev/null || true
  cryptsetup close cryptsystem 2>/dev/null || true

  whiptail --title "Artix — Done" --msgbox "Install Complete. Reboot, Pull the USB Stick, Done.

User:      $USERNAME
Hostname:  $HOSTNAME
Timezone:  $TIMEZONE
Locale:    $LOCALE
Disk:      $DISK
LUKS2:     ON — Disk Passphrase Asked Once At Boot
Firewall:  ufw ON — All Incoming Denied

Greeter → Login → Hyprland. Enjoy the Freedom." 17 60
}

# ============================================================================
main() {
  banner
  : > "$LOG"
  ensure_deps
  ask_questions
  select_disk
  partition_disk
  write_keyfiles
  basestrap_target
  configure_users
  make_fstab
  enable_services
  deploy_configs
  install_grub
  configure_firewall
  finish
}

main "$@"