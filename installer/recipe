ask_questions() {
  step "Asking The Only Questions That Matter"

  HOSTNAME=$(whiptail --inputbox "Machine Name (Hostname):" 10 50 "artix" \
    --title "Artix — Hostname" 3>&1 1>&2 2>&3) || exit 1

  REALNAME=$(whiptail --inputbox "Your Full Name (Display Name):" 10 50 "" \
    --title "Artix — Name" 3>&1 1>&2 2>&3) || exit 1

  while :; do
    USERNAME=$(whiptail --inputbox "Username (Lowercase, No Spaces):" 10 50 "" \
      --title "Artix — Username" 3>&1 1>&2 2>&3) || exit 1
    [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { whiptail --msgbox "Invalid Username." 8 40; continue; }
    break
  done

  while :; do
    ROOT_PW=$(whiptail --passwordbox "Root Password:" 10 50 "" \
      --title "Artix — Root Password" 3>&1 1>&2 2>&3) || exit 1
    ROOT_PW2=$(whiptail --passwordbox "Repeat Root Password:" 10 50 "" 3>&1 1>&2 2>&3) || exit 1
    [ -n "$ROOT_PW" ] && [ "$ROOT_PW" = "$ROOT_PW2" ] && break
    whiptail --msgbox "Passwords Empty Or Do Not Match." 8 45
  done

  while :; do
    USER_PW=$(whiptail --passwordbox "Password For $USERNAME:" 10 50 "" \
      --title "Artix — User Password" 3>&1 1>&2 2>&3) || exit 1
    USER_PW2=$(whiptail --passwordbox "Repeat Password:" 10 50 "" 3>&1 1>&2 2>&3) || exit 1
