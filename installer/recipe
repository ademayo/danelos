set -eEuo pipefail

VERSION="0.2"
MNT=/mnt
LOG=/tmp/install.log
SRC="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-.}")")/.."

# ----------------------------------------------------------------------------
# Look and Feel
# ----------------------------------------------------------------------------
R=$'\e[1;35m'   # Magenta
C=$'\e[1;36m'   # Cyan
G=$'\e[1;32m'   # Green
Y=$'\e[1;33m'   # Yellow
D=$'\e[1;31m'   # Red
B=$'\e[1;34m'   # Blue
N=$'\e[0m'

banner() {
  echo -e "${R}"
  echo "  ██████╗  █████╗ ███╗   ██╗███████╗██╗      ██████╗ ███████╗"
  echo "  ██╔══██╗██╔══██╗████╗  ██║██╔════╝██║     ██╔══██╗██╔════╝"
  echo "  ██║  ██║███████║██╔██╗ ██║█████╗  ██║     ██║  ██║███████╗"
  echo "  ██║  ██║██╔══██║██║╚██╗██║██╔══╝  ██║     ██║  ██║╚════██║"
  echo "  ██████╔╝██║  ██║██║ ╚████║███████╗███████╗██████╔╝███████║"
  echo "  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝╚══════╝╚═════╝ ╚══════╝"
