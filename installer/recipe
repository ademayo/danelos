#!/usr/bin/env bash
# ============================================================================
#  ██████╗  █████╗ ███╗   ██╗███████╗██╗      ██████╗ ███████╗
#  ██╔══██╗██╔══██╗████╗  ██║██╔════╝██║     ██╔══██╗██╔════╝
#  ██║  ██║███████║██╔██╗ ██║█████╗  ██║     ██║  ██║███████╗
#  ██║  ██║██╔══██║██║╚██╗██║██╔══╝  ██║     ██║  ██║╚════██║
#  ██████╔╝██║  ██║██║ ╚████║███████╗███████╗██████╔╝███████║
#  Desktop Layer Installer — Already-Installed Artix (base + dinit + Chaotic-AUR)
#
#    git clone https://github.com/ademayo/danelos.git && \
#      sudo ./danelos/installer/recipe
# ============================================================================
set -eEuo pipefail

VERSION="0.3"
LOG=/tmp/install.log
SRC="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-.}")")/.."

# ----------------------------------------------------------------------------
# Look and Feel
# ----------------------------------------------------------------------------
R=$'\e[1;35m'   # Magenta
C=$'\e[1;36m'   # Cyan
G=$'\e[1;32m'   # Green
Y=$'\e[1;33m'   # Yellow
D=$'\e[1;31m'   # Red
B=$'\e[1;34m'   # Blue
N=$'\e[0m'

banner() {
  echo -e "${R}"
  echo "  ██████╗  █████╗ ███╗   ██╗███████╗██╗      ██████╗ ███████╗"
  echo "  ██╔══██╗██╔══██╗████╗  ██║██╔════╝██║     ██╔══██╗██╔════╝"
  echo "  ██║  ██║███████║██╔██╗ ██║█████╗  ██║     ██║  ██║███████╗"
  echo "  ██║  ██║██╔══██║██║╚██╗██║██╔══╝  ██║     ██║  ██║╚════██║"
  echo "  ██████╔╝██║  ██║██║ ╚████║███████╗███████╗██████╔╝███████║"
  echo "  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝╚══════╝╚═════╝ ╚══════╝"
  echo -e "${Y}  v${VERSION} — Desktop Layer · Base Artix + dinit + Chaotic-AUR Required · No Disks Touched${N}"
}
log()  { echo -e "${G}::${N} $*" | tee -a "$LOG"; }
step() { echo -e "\n${C}==> ${B}$*${N}" | tee -a "$LOG"; }
warn() { echo -e "${Y} !! $*${N}" | tee -a "$LOG"; }
die()  { echo -e "${D}FATAL: $*${N}" | tee -a "$LOG" >&2; exit 1; }

# ----------------------------------------------------------------------------
# Preflight
# ----------------------------------------------------------------------------
[ "$(id -u)" = 0 ] || die "Run As Root."
grep -qs 'Artix' /etc/os-release || die "This Installer Must Run On Artix Linux."

# ----------------------------------------------------------------------------
# Dependencies
# ----------------------------------------------------------------------------
ensure_deps() {
  step "Checking Dependencies"
  local missing=()
  for c in whiptail vim git; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    log "Installing Missing Tools: ${missing[*]}"
    pacman -Sy --noconfirm --needed libnewt vim git >>"$LOG" 2>&1 \
      || die "Tool Install Failed (${missing[*]}) — Check $LOG."
  fi
  command -v whiptail >/dev/null 2>&1 || die "whiptail Unavailable — Install libnewt."
  command -v git >/dev/null 2>&1 || die "git Unavailable."

  # Chaotic-AUR is required for ungoogled-chromium-bin and papirus-folders.
  if ! grep -qs '^\[chaotic-aur\]' /etc/pacman.conf; then
    warn "[chaotic-aur] not found in /etc/pacman.conf — some desktop packages (ungoogled-chromium-bin, papirus-folders) may fail."
  fi
}

# ----------------------------------------------------------------------------
# Ask which existing user gets the desktop config
# ----------------------------------------------------------------------------
ask_questions() {
  step "Asking The Only Question That Matters"

  while :; do
    USERNAME=$(whiptail --inputbox "Username (Lowercase, No Spaces):" 10 50 "" \
      --title "Artix — Username" 3>&1 1>&2 2>&3) || exit 1
    [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { whiptail --msgbox "Invalid Username." 8 40; continue; }
    if ! id -u "$USERNAME" >/dev/null 2>&1; then
      whiptail --msgbox "User '$USERNAME' does not exist.\nCreate the user first, then re-run this installer." 9 60
      continue
    fi
    break
  done

  REALNAME=$(getent passwd "$USERNAME" | cut -d: -f5 | cut -d',' -f1)
}


# ----------------------------------------------------------------------------
# Target Packages
# ----------------------------------------------------------------------------
install_desktop_pkgs() {
  step "Installing Desktop Packages"
  local -a desk_pkgs=() line
  while IFS= read -r line; do
    line="${line%%#*}"; line="$(echo "$line" | xargs)" || true
    [ -z "$line" ] && continue
    desk_pkgs+=("$line")
  done < "$SRC/packages/desktop.packages"

  pacman -Syu --noconfirm --needed >>"$LOG" 2>&1
  pacman -Sy --noconfirm --needed --asexplicit "${desk_pkgs[@]}" >>"$LOG" 2>&1 \
    || die "Desktop Package Install Failed — Check $LOG."
}

# ----------------------------------------------------------------------------
# User Setup
# ----------------------------------------------------------------------------
configure_users() {
  # User and root already set up on the base system. Just ensure the target
  # user is in the standard device groups and has zsh as login shell.
  step "Confirming User"
  usermod -aG audio,video,optical,storage,lp,input,network "$USERNAME" 2>/dev/null || true
  if [ -x /bin/zsh ] && [ "$(getent passwd "$USERNAME" | cut -d: -f7)" != "/bin/zsh" ]; then
    usermod -s /bin/zsh "$USERNAME"
  fi
}

enable_services() {
  step "Enabling dinit Services"
  install -d -m755 /etc/dinit.d/boot.d
  for svc in NetworkManager ufw bluetoothd avahi-daemon sshd cronie greetd userspawn tlp plymouth; do
    [ -e "/etc/dinit.d/$svc" ] && ln -sfn "/etc/dinit.d/$svc" "/etc/dinit.d/boot.d/$svc" 2>/dev/null || true
  done
  # User dinit services
  local home_dir="/home/$USERNAME"
  if [ -d "$home_dir" ]; then
    install -d -m755 "$home_dir/.config/dinit.d/boot.d"
    for s in dbus pipewire pipewire-pulse wireplumber; do
      [ -e "/etc/dinit.d/user/$s" ] && ln -sfn "/etc/dinit.d/user/$s" "$home_dir/.config/dinit.d/boot.d/$s"
    done
    chown -R "$USERNAME:" "$home_dir/.config"
  fi
  dbus-uuidgen --ensure >/dev/null 2>&1 || true
  [ -f /var/lib/dbus/machine-id ] && [ ! -f /etc/machine-id ] && \
    cp /var/lib/dbus/machine-id /etc/machine-id || true
}

# ----------------------------------------------------------------------------
# Desktop Config Layer
# ----------------------------------------------------------------------------
deploy_configs() {
  # The Config Layer Lives In the Cloned Repo, Sibling To installer/
  [ -d "$SRC/conf" ] || die "Config Layer Missing Next To The Installer — Clone the Full Repo (git clone), Not a Single File."

  step "Deploying Desktop Configs"

  local u_home="/home/$USERNAME"
  install -d -m755 "$u_home"/.config/{hypr,quickshell,ghostty,wlogout,gtk-3.0,gtk-4.0,qt6ct,fontconfig,dinit} "$u_home"/.local/bin

  cp -r "$SRC"/conf/hypr/.       "$u_home/.config/hypr/"
  cp -r "$SRC"/conf/quickshell/. "$u_home/.config/quickshell/"
  cp -r "$SRC"/conf/ghostty/.    "$u_home/.config/ghostty/"
  cp -r "$SRC"/conf/wlogout/.    "$u_home/.config/wlogout/"
  cp -r "$SRC"/conf/gtk/.     "$u_home/.config/"
  cp -r "$SRC"/conf/qt/.      "$u_home/.config/qt6ct/"

  # Resolve the $USER placeholder in the qt6ct color-scheme path so the
  # custom palette is found without manual edits.
  if [ -f "$u_home/.config/qt6ct/qt6ct.conf" ]; then
    sed -i "s|/home/\$USER/|/home/$USERNAME/|g" "$u_home/.config/qt6ct/qt6ct.conf"
  fi

  # Make Xresources active for the current user on next X/Wayland session start.
  install -Dm644 "$SRC"/conf/gtk/Xresources "$u_home/.Xresources"
  cp "$SRC"/conf/zsh/zshrc    "$u_home/.zshrc"
  cp "$SRC"/conf/vim/vimrc    "$u_home/.vimrc"
  install -Dm755 "$SRC"/conf/bin/keybind-cheatsheet "$u_home/.local/bin/keybind-cheatsheet"

  chown -R "$USERNAME:" "$u_home/.config" "$u_home/.local/bin" "$u_home/.vimrc" "$u_home/.zshrc"

  install -Dm644 "$SRC"/system/greetd/config.toml /etc/greetd/config.toml
  install -Dm644 "$SRC"/system/tlp/tlp.conf /etc/tlp.conf
  install -Dm644 "$SRC"/system/plymouth/plymouthd.conf /etc/plymouth/plymouthd.conf

  install -d /usr/share/backgrounds
  cp "$SRC"/wallpapers/*.jpg /usr/share/backgrounds/

  # Dark Folders For Papirus Icons
  sudo -u "$USERNAME" papirus-folders -C ePapirus-Dark --theme Papirus-Dark >/dev/null 2>&1 || true
}

configure_firewall() {
  step "Configuring ufw Firewall"
  sed -i 's/^ENABLED=no/ENABLED=yes/' /etc/ufw/ufw.conf
  sed -i 's/^IPV6=no/IPV6=yes/' /etc/default/ufw
  ufw --force reset >>"$LOG" 2>&1 || true
  ufw default deny incoming >>"$LOG" 2>&1
  ufw default allow outgoing >>"$LOG" 2>&1
  ufw allow in on lo >>"$LOG" 2>&1
  ufw allow out on lo >>"$LOG" 2>&1
  ufw allow in proto udp from any port 67 to any port 68 >>"$LOG" 2>&1
  ufw allow in proto ipv6 from fe80::/10 >>"$LOG" 2>&1
  ufw --force enable >>"$LOG" 2>&1
  log "ufw Status:"
  ufw status verbose | sed 's/^/    /' | tee -a "$LOG"
}

# ----------------------------------------------------------------------------
# Fin
# ----------------------------------------------------------------------------
finish() {
  whiptail --title "Artix — Desktop Layer Done" --msgbox "Desktop Layer Installed.

User:      $USERNAME
Login:     greetd + tuigreet → Hyprland
Firewall:  ufw ON — All Incoming Denied

Enable greetd if it isn't already, then reboot or start the dinit service." 14 60
}

# ============================================================================
main() {
  banner
  : > "$LOG"
  ensure_deps
  ask_questions
  install_desktop_pkgs
  configure_users
  enable_services
  deploy_configs
  configure_firewall
  finish
}

main "$@"